{
  "name": "financial",
  "version": "1.0.0",
  "description": "Financial identifiers — credit cards, SSN, IBAN.",
  "rules": [
    {
      "name": "credit_card",
      "pattern": "\\b(?:\\d[ -]*?){13,19}\\b",
      "action": { "type": "black_box" },
      "description": "Credit card number (Luhn-validated)",
      "severity": "critical",
      "validator": "luhn"
    },
    {
      "name": "ssn_us",
      "pattern": "\\b\\d{3}-\\d{2}-\\d{4}\\b",
      "action": { "type": "black_box" },
      "description": "US Social Security Number",
      "severity": "critical"
    },
    {
      "name": "iban",
      "pattern": "\\b[A-Z]{2}\\d{2}[A-Z0-9]{11,30}\\b",
      "action": { "type": "mask", "replacement": "[IBAN]" },
      "description": "International Bank Account Number",
      "severity": "high"
    },
    {
      "name": "swift_bic",
      "pattern": "\\b[A-Z]{4}[A-Z]{2}[A-Z0-9]{2}(?:[A-Z0-9]{3})?\\b",
      "action": { "type": "flag" },
      "description": "SWIFT/BIC bank code",
      "severity": "low"
    }
  ]
}
